# =============================================================================
# rookie-agent 生产环境配置（Linux 物理机 / 云主机，systemd 托管）
#
# 用法：
#   cp deploy/env.production.example .env
#   chmod 600 .env        # 内含 Telegram token 与 API Key，必须收紧权限
#   nano .env             # 至少填 TELEGRAM_BOT_TOKEN、TELEGRAM_ALLOWED_CHAT_IDS、模型端点密钥
#
# 路径约定（v0.1.0 起）：
#   所有相对路径都以**项目根目录**为基准解析，而不是当前工作目录。
#   所以 systemd（WorkingDirectory 已设为项目根）与手动前台运行的配置完全一致，
#   不需要再手工写一堆绝对路径。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Codex 主脑
# -----------------------------------------------------------------------------
# 方式 A（推荐，无人值守）：填 API Key，CodexBrain 启动时会用它登录
OPENAI_API_KEY=
# 方式 B：不填 Key，复用机器上已有的 Codex 登录态
#         先在**服务运行账号**下登录一次：  codex login
#         ⚠️ 登录态存在 ~/.codex/auth.json，该文件必须属于服务账号，否则读不到。

AGENT_CODEX_MODEL=gpt-5.6-terra
# read_only（默认，推荐）| workspace_write | full_access
# read_only 下 agent 照样能跑 ls / git status / pytest，只是不能写文件、不能联网 ——
# 对"陪伴型助手"这个定位已经够用，且爆炸半径最小。
AGENT_CODEX_SANDBOX=read_only

# 审批模式：SDK 只有 auto_review / deny_all 两个成员（内省实测，别照搬 CLI 文档的 never/untrusted）。
# 无人值守必须用 deny_all：行为确定、fail-closed，让沙箱成为唯一边界。
AGENT_CODEX_APPROVAL_MODE=deny_all

# 主脑工作目录。留空 = 项目根目录。
AGENT_CODEX_CWD=

# 单轮超时（秒）。Codex 卡死时由 orchestrator 取消。
AGENT_TURN_TIMEOUT_SEC=180

# -----------------------------------------------------------------------------
# 2. Telegram 信道
# -----------------------------------------------------------------------------
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# ⚠️ **必填**。白名单语义是"空 = 不限制"，而本系统默认开启了执行能力
# （AGENT_EXEC_ENABLED=true），两者叠加等于"任何人都能让这台机器跑命令"。
# 所以 validate_security() 是 fail-closed：白名单为空会**拒绝启动（exit 2）**。
#
# 获取自己的 chat id：给机器人发一条消息，然后访问
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# 在返回 JSON 里找 "chat":{"id":123456789}。多个用英文逗号分隔。
TELEGRAM_ALLOWED_CHAT_IDS=

# -----------------------------------------------------------------------------
# 3. 长期记忆（MemPalace）
# -----------------------------------------------------------------------------
# 留空 = ~/.mempalace/palace 与 ~/.mempalace/knowledge_graph.sqlite3（推荐）
# 想放进项目内做整体备份，就写 var/mempalace/palace（相对路径以项目根为基准）
MEMPALACE_PALACE_PATH=
MEMPALACE_KG_PATH=

AGENT_WING=wing_agent
AGENT_ROOM_DEFAULT=conversation
AGENT_MEMORY_TOPK=5
# 每轮对话落成逐字记忆（写入成本低，建议开）
AGENT_PERSIST_TURNS=true
# 用 Codex 抽取实体/关系写知识图谱（多一次模型调用，按需开启）
AGENT_EXTRACT_FACTS=false

# MCP server 用的解释器。**留空即可** —— 默认就是当前解释器（sys.executable），
# 这保证了子进程跑在同一个 venv 里。只有需要特殊指定时才填绝对路径。
# AGENT_MCP_COMMAND=/opt/rookie-agent/.venv/bin/python

# -----------------------------------------------------------------------------
# 4. 多模态模型（vision / stt / tts 各自独立配置端点，可以分别指向不同厂商）
# -----------------------------------------------------------------------------
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Telegram sendVoice 只接受 OGG/Opus；装了 ffmpeg 就自动转码出语音气泡，
# 没有则降级发送 mp3 音频文件（功能不中断，只是样式不同）。
FFMPEG_BIN=ffmpeg

# -----------------------------------------------------------------------------
# 5. 分身调度
# -----------------------------------------------------------------------------
AGENT_MAX_PARALLEL_TASKS=4
AGENT_CLONE_TIMEOUT_SEC=600

# -----------------------------------------------------------------------------
# 6. 运行数据目录
# -----------------------------------------------------------------------------
# 留空 = <项目根>/var（推荐，配合 systemd 的 ReadWritePaths）
# 要放到独立数据盘就写绝对路径，例如 /srv/rookie-agent/var
AGENT_DATA_DIR=

AGENT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 7. 应用侧执行入口（**与 Codex 沙箱是两条独立的路，别混淆**）
# -----------------------------------------------------------------------------
# 模型自己跑命令 → Codex 内置 shell，受 Codex 的 OS 级沙箱约束（Linux = bubblewrap + seccomp）
# 我们自己的代码跑命令 → 下面这两组，**不受任何沙箱约束**，权限等于当前进程
#
# 内部白名单命令（只允许 app/local_exec.py 里登记过的命令，不接受自由命令）
AGENT_EXEC_ENABLED=true
AGENT_EXEC_TIMEOUT_SEC=60
AGENT_EXEC_MAX_OUTPUT_CHARS=4000
AGENT_EXEC_MAX_CAPTURE_BYTES=131072
# 命令审计：把 Codex 跑过的命令脱敏后写进长期记忆，用 /audit <关键词> 检索
AGENT_EXEC_AUDIT_TO_MEMORY=true
AGENT_EXEC_AUDIT_ROOM=shell-audit
AGENT_EXEC_AUDIT_OUTPUT_CHARS=300

# 长驻进程（start/logs/stop）。**默认关闭**，且不受任何沙箱约束。
# 开启前请确认服务跑在专用账号（systemd 的 User=n100）而不是 root。
AGENT_PROCESS_ENABLED=false
AGENT_PROCESS_MAX=3
AGENT_PROCESS_GRACE_SEC=5
AGENT_PROCESS_MAX_LOG_BYTES=262144
