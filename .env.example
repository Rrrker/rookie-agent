# ============================================================
# 复制为 .env 后填写。已存在的真实环境变量优先于本文件。
# Windows 路径统一用正斜杠，避免转义问题。
# ============================================================

# ---------- 1. Codex 主脑 ----------
# 复用已有 Codex 登录态时可不填；否则填 API Key
OPENAI_API_KEY=
AGENT_CODEX_MODEL=gpt-5.6-terra
AGENT_CODEX_SANDBOX=read_only          # read_only | workspace_write | full_access

# ---------- 2. Telegram 信道 ----------
TELEGRAM_BOT_TOKEN=
# 白名单，逗号分隔；留空表示不限制（不推荐）
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- 3. 记忆层（MemPalace）----------
# 留空即使用默认路径 ~/.mempalace/...（Linux / macOS 直接用默认值就行）
# Windows 如需显式指定，写正斜杠路径，例如 C:/Users/your-name/.mempalace/palace
MEMPALACE_PALACE_PATH=
MEMPALACE_KG_PATH=
AGENT_WING=wing_agent
AGENT_ROOM_DEFAULT=conversation
AGENT_MEMORY_TOPK=5

# ---------- 4. 多模态模型（各自独立的 OpenAI 兼容端点）----------
# 识图
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
# 语音转文本
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# 文本转语音
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Telegram sendVoice 需要 OGG/Opus，用 ffmpeg 转码；没有则降级发音频文件
FFMPEG_BIN=ffmpeg

# ---------- 5. 分身调度 ----------
AGENT_MAX_PARALLEL_TASKS=4
AGENT_CLONE_TIMEOUT_SEC=600
AGENT_DATA_DIR=./var
AGENT_LOG_LEVEL=INFO

# ---------- 6. Codex 审批模式 ----------
# 已用内省实测：SDK 的 ApprovalMode 只有两个成员 —— auto_review / deny_all。
# 不存在 CLI 侧的 never / untrusted / on_request，不要照搬文档。
# 无人值守（Telegram）建议 deny_all：行为确定、fail-closed，沙箱是唯一边界。
AGENT_CODEX_APPROVAL_MODE=deny_all

# ---------- 7. 应用侧执行入口（**注意与 Codex 沙箱的区别**）----------
# 模型自己跑命令用的是 Codex 内置 shell，受 Codex 的 OS 级沙箱约束；
# 下面这两组是"我们自己的代码"（orchestrator / cron）的执行入口，
# **不受 Codex 沙箱约束**，权限等于当前进程，所以默认更保守。
#
# 内部白名单命令（只允许登记过的命令，见 app/local_exec.py 的 NAMED_COMMANDS）
AGENT_EXEC_ENABLED=true
AGENT_EXEC_WORKDIR=./var/exec
AGENT_EXEC_TIMEOUT_SEC=60
AGENT_EXEC_MAX_OUTPUT_CHARS=4000
# 进程级上限：读到这么多字节就杀进程（防 `yes` 把内存吃穿）
AGENT_EXEC_MAX_CAPTURE_BYTES=131072
# 命令审计：把 Codex 跑过的命令（脱敏后）写进长期记忆
AGENT_EXEC_AUDIT_TO_MEMORY=true
AGENT_EXEC_AUDIT_ROOM=shell-audit
AGENT_EXEC_AUDIT_OUTPUT_CHARS=300

# 长驻进程：**默认关闭**。开启前请确保运行在容器或专用账号下。
AGENT_PROCESS_ENABLED=false
AGENT_PROCESS_WORKDIR=./var/procs
AGENT_PROCESS_MAX=3
AGENT_PROCESS_GRACE_SEC=5
AGENT_PROCESS_MAX_LOG_BYTES=262144
